<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps under the status bar by default, where the top buttons
         can't be tapped. Keep the classic layout: the WebView starts below the bars. -->
    <style name="AppTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
